# Example environment variables for OctoFit Tracker frontend
# Copy this file to .env.local and update the value for your Codespaces environment.

# Required for Codespaces-based API routing.
# When set, the app uses:
#   https://$VITE_CODESPACE_NAME-8000.app.github.dev/api
# When unset it falls back to localhost:
#   http://localhost:8000/api
VITE_CODESPACE_NAME=your-codespace-name
